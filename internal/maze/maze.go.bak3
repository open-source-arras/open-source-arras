        --------------------------------
      `)
	if err := repeatN(5, func() error { return g.erodeSym2(0, 2) }); err != nil {
		return err
	}
	if err := repeatN(5, func() error {
		if err := g.erodeSym2(0, 2); err != nil {
			return err
		}
		if err := g.erodeSym2(2, 2); err != nil {
			return err
		}
		if err := g.erodeSym2(2, 2); err != nil {
			return err
		}
		return g.erodeSym2(2, 2)
	}); err != nil {
		return err
	}
	if err := repeatN(10, func() error {
		if err := g.erodeSym2(1, 2); err != nil {
			return err
		}
		if err := g.erodeSym2(0, 2); err != nil {
			return err
		}
		if err := g.erodeSym2(2, 2); err != nil {
			return err
		}
		if err := g.erodeSym2(2, 2); err != nil {
			return err
		}
		return g.erodeSym2(2, 2)
	}); err != nil {
		return err
	}
	if err := repeatN(75, func() error { return g.erodeSym2(1, 2) }); err != nil {
