// runYinYang mirrors MazeGenerator.runYinYang (mazeGenerator.js:958-1000):
// mazeType 20.
//
// BUG (mazeGenerator.js:993-995), ported as-is -- see docs/found-bugs.md:
//
//	for (let i = 0; i < 8; i++)
//	  this.erodeSym2(0, 2)
//	  this.erodeSym2(1, 2)
//
// has no braces, so only the first line is the loop body. The second
// erodeSym2(1, 2) call runs once, after the loop, not 8 times inside it, as
// the shared indentation implies it should.
func (g *MazeGenerator) runYinYang() error {
	g.clear(`
          --------------------------------
          -------################@@-------
          ----####---#-#---#----####-@----
          ----###--------###-##----#------
          -----------#--------------#-@@--
          -------#--#--#-@-#---##---#-@@@-
          ----@@-#--#-##---#-#--##--@-@@@-
          -----##---#-#---##-##--#--@-@@@-
          ---@-#--###---##@@--#--#----@@@-
          ---#-#-##-#---#@@--###----#-#@@-
          ---@#--#--##--#-----#---##--#@@-
          ---###------#---#-#----#-##-#@@-
          -----###------##---###----#-#---
          -------#----######---##-#---#---
          ----##-####------##-----#--##@--
          ----------##-#----###--##--#----
          ----#-##-#-###----#-##----------
          --@##--#-----##------####-##----
          ---#---#-##---######----#-------
          ---#-#----###---##------###-----
          -@@#-##-#----#-#---#------###---
          -@@#--##---#-----#--##--#--#@---
          -@@#-#----###--@@#---#-##-#-#---
          -@@@----#--#--@@##---###--#-@---
          -@@@-@--#--##-##---#-#---##-----
          -@@@-@--##--#-#---##-#--#-@@----
          -@@@-#---##---#-@-#--#--#-------
          --@@-#--------------#-----------
          ------#----##-###--------###----
          ----@-####----#---#-#---####----
          -------@@################-------
          --------------------------------
        `)
	if err := repeatN(8, func() error { return g.erodeSym2(0, 2) }); err != nil {
		return err
	}
	if err := g.erodeSym2(1, 2); err != nil {
		return err
	}
	if err := repeatN(6, func() error { return g.erodeSym2(constraintNone, constraintNone) }); err != nil {
		return err
	}
	return repeatN(4, func() error { return g.erodeSym2(1, 2) })
}

