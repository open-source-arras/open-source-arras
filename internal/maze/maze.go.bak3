// Package maze is the erosion-based maze generator from js-src/server/miscFiles/mazeGenerator.js.
package maze

import (
	"fmt"
	"math"
	"strings"

	"arrasgo/internal/jsutil"
)

// cellState is one grid cell, with zero value cellEmpty for open cells.
type cellState uint8

const (
	cellEmpty    cellState = iota // JS false: open, passable
	cellWall                      // JS true: a wall randomErosion can knock down
	cellHardWall                  // JS number 1 (from '#'): a wall it never can
)

// newGrid allocates a grid with the given dimensions.
func newGrid(width, height int) [][]cellState {
	g := make([][]cellState, width)
	for x := range g {
		g[x] = make([]cellState, height)
	}
	return g
}

// erosionConstraint represents constraint values: none, either, or exact counts 0,1,2.
type erosionConstraint int

const (
	constraintNone   erosionConstraint = -2 // JS null: unconstrained
	constraintEither erosionConstraint = -1 // JS true: left || right
)

// constraintOK checks if constraint c is satisfied by the neighbour state.
func constraintOK(c erosionConstraint, left, right bool) bool {
	switch c {
	case constraintNone:
		return true
	case constraintEither:
		return left || right
	}
	count := 0
	if left {
		count++
	}
	if right {
		count++
	}
	return int(c) == count
}

// Square is one axis-aligned filled block from the maze.
type Square struct {
	X, Y, Size int
}

// Result holds the wall squares and grid dimensions for maze placement.
type Result struct {
	Squares []Square
	Width   int
	Height  int
}

// MazeGenerator is the maze generation algorithm.
type MazeGenerator struct {
	mazeType      int
	rng           *jsutil.Rand
	staticRand    float64
	maze          [][]cellState // [x][y]
	width, height int
	hasToBeClosed bool
}

// NewMazeGenerator constructs a new maze generator with the given type and RNG.
func NewMazeGenerator(mazeType int, rng *jsutil.Rand) *MazeGenerator {
	g := &MazeGenerator{
		mazeType:      mazeType,
		rng:           rng,
		staticRand:    rng.Random(1), // Math.random(), mazeGenerator.js:147
		hasToBeClosed: mazeType == 13 || mazeType == 80,
	}
	g.clearBlank()
	return g
}

// clear initializes the grid from a map string or uses a blank 32x32 grid.
func (g *MazeGenerator) clear(mapString string) {
	if mapString == "" {
		g.clearBlank()
		return
	}
	g.clearFromMap(mapString)
}

// clearBlank initializes a 32x32 grid of all-open cells.
func (g *MazeGenerator) clearBlank() {
	g.width, g.height = 32, 32
	g.maze = newGrid(32, 32)
}

// clearFromMap initializes the grid from a map string.
func (g *MazeGenerator) clearFromMap(mapString string) {
	lines := splitTrimmedLines(mapString)
	height := len(lines)
	width := 0
	if height > 0 {
		width = len(lines[0])
	}
	maze := newGrid(width, height)
	for y, line := range lines {
		for x := 0; x < width && x < len(line); x++ {
			switch line[x] {
			case '#':
				maze[x][y] = cellHardWall
			case '@':
				maze[x][y] = cellWall
			default:
				maze[x][y] = cellEmpty
			}
		}
	}
	g.maze, g.width, g.height = maze, width, height
}

// splitTrimmedLines trims and splits a string into trimmed lines.
func splitTrimmedLines(s string) []string {
	s = strings.TrimSpace(s)
	if s == "" {
		return nil
	}
	lines := strings.Split(s, "\n")
	for i, line := range lines {
		lines[i] = strings.TrimSpace(line)
	}
	return lines
}

// isClosed returns true if there are unreachable open cells.
func (g *MazeGenerator) isClosed() bool {
	reached := newBoolGrid(g.width, g.height)
	stack := make([][2]int, 0, g.width+g.height)

	push := func(x, y int) {
		if x < 0 || x >= g.width || y < 0 || y >= g.height {
			return
		}
		if g.maze[x][y] != cellEmpty || reached[x][y] {
			return
		}
		reached[x][y] = true
		stack = append(stack, [2]int{x, y})
	}

	for x := 0; x < g.width; x++ {
		for y := 0; y < g.height; y++ {
			if x == 0 || x == g.width-1 || y == 0 || y == g.height-1 {
				push(x, y)
			}
		}
	}
	for len(stack) > 0 {
		n := len(stack) - 1
		x, y := stack[n][0], stack[n][1]
		stack = stack[:n]
		push(x+1, y)
		push(x-1, y)
		push(x, y+1)
		push(x, y-1)
	}

	for x := 0; x < g.width; x++ {
		for y := 0; y < g.height; y++ {
			if g.maze[x][y] == cellEmpty && !reached[x][y] {
				return true
			}
		}
	}
	return false
}

func newBoolGrid(width, height int) [][]bool {
	g := make([][]bool, width)
	for x := range g {
		g[x] = make([]bool, height)
	}
	return g
}

// randIndex returns a uniform random index in [0, n).
func randIndex(r *jsutil.Rand, n int) int {
	return int(math.Floor(r.Random(float64(n))))
}

// randomErosion picks a wall cell that satisfies the constraints and returns its coordinates.
func (g *MazeGenerator) randomErosion(side, corner erosionConstraint) (tx, ty int, err error) {
	for i := 0; i < 10000; i++ {
		x := randIndex(g.rng, g.width)
		y := randIndex(g.rng, g.height)
		if g.maze[x][y] != cellEmpty {
			continue
		}
		if (x == 0 || x == g.width-1) && (y == 0 || y == g.height-1) {
			continue // a literal corner of the grid: no single "outward" direction
		}

		direction := randIndex(g.rng, 4)
		switch {
		case x == 0:
			direction = 0
		case y == 0:
			direction = 1
		case x == g.width-1:
			direction = 2
		case y == g.height-1:
			direction = 3
		}
		tx, ty = x, y
		switch direction {
		case 0:
			tx = x + 1
		case 2:
			tx = x - 1
		}
		switch direction {
		case 1:
			ty = y + 1
		case 3:
			ty = y - 1
		}
		// cellHardWall fails this check, just like cellEmpty does.
		if g.maze[tx][ty] != cellWall {
			continue
		}

		if corner != constraintNone {
			leftX, leftY := cornerLeft(x, y, direction)
			rightX, rightY := cornerRight(x, y, direction)
			left := g.maze[leftX][leftY] != cellEmpty
			right := g.maze[rightX][rightY] != cellEmpty
			if !constraintOK(corner, left, right) {
				continue
			}
		}

		if side != constraintNone {
			leftX, leftY := sideLeft(x, y, direction)
			rightX, rightY := sideRight(x, y, direction)
			left := g.maze[leftX][leftY] != cellEmpty
			right := g.maze[rightX][rightY] != cellEmpty
			if !constraintOK(side, left, right) {
				continue
			}
		}

		return tx, ty, nil
	}
	return 0, 0, fmt.Errorf("maze: unable to find suitable erosion site; side=%d corner=%d", side, corner)
}

// cornerLeft returns the left diagonal neighbour for the given direction.
func cornerLeft(x, y, direction int) (int, int) {
	lx := x + 1
	if direction == 2 || direction == 3 {
		lx = x - 1
	}
	ly := y + 1
	if direction == 0 || direction == 3 {
		ly = y - 1
	}
	return lx, ly
}

func cornerRight(x, y, direction int) (int, int) {
	rx := x + 1
	if direction == 1 || direction == 2 {
		rx = x - 1
	}
	ry := y + 1
	if direction == 2 || direction == 3 {
		ry = y - 1
	}
	return rx, ry
}

// sideLeft returns the left neighbour for the given direction.
func sideLeft(x, y, direction int) (int, int) {
	lx := x
	switch direction {
	case 3:
		lx = x + 1
	case 1:
		lx = x - 1
	}
	ly := y
	switch direction {
	case 0:
		ly = y + 1
	case 2:
		ly = y - 1
	}
	return lx, ly
}

func sideRight(x, y, direction int) (int, int) {
	rx := x
	switch direction {
	case 1:
		rx = x + 1
	case 3:
		rx = x - 1
	}
	ry := y
	switch direction {
	case 2:
		ry = y + 1
	case 0:
		ry = y - 1
	}
	return rx, ry
}

// erode knocks down one wall cell.
func (g *MazeGenerator) erode(side, corner erosionConstraint) error {
	x, y, err := g.randomErosion(side, corner)
	if err != nil {
		return err
	}
	g.maze[x][y] = cellEmpty
	return nil
}

// erodeSym2 knocks down a cell and its 180-degree-rotation partner.
func (g *MazeGenerator) erodeSym2(side, corner erosionConstraint) error {
	x, y, err := g.randomErosion(side, corner)
	if err != nil {
		return err
	}
	g.maze[x][y] = cellEmpty
	g.maze[g.width-1-x][g.height-1-y] = cellEmpty
	return nil
}

// erodeSym4 knocks down a cell and its three symmetric partners. Requires a square grid.
func (g *MazeGenerator) erodeSym4(side, corner erosionConstraint) error {
	if g.width != g.height {
		return fmt.Errorf("maze: erodeSym4 requires a square maze, got %dx%d", g.width, g.height)
	}
	size := g.width - 1
	x, y, err := g.randomErosion(side, corner)
	if err != nil {
		return err
	}
	if g.staticRand < 0.5 {
		g.maze[x][y] = cellEmpty
		g.maze[x][size-y] = cellEmpty
		g.maze[size-x][y] = cellEmpty
		g.maze[size-x][size-y] = cellEmpty
	} else {
		g.maze[x][y] = cellEmpty
		g.maze[y][size-x] = cellEmpty
		g.maze[size-x][size-y] = cellEmpty
		g.maze[size-y][x] = cellEmpty
	}
	return nil
}

// repeatN runs f n times, stopping at its first error.
func repeatN(n int, f func() error) error {
	for i := 0; i < n; i++ {
		if err := f(); err != nil {
			return err
		}
	}
	return nil
}

// runNormal generates mazeType 0, a single open room.
func (g *MazeGenerator) runNormal() error {
	g.clear(`
        --------------------------------
        -@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@-
        -@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@-
        -@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@-
        -@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@-
        -@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@-
        -@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@-
        -@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@-
        -@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@-
        -@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@-
        -@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@-
        -@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@-
        -@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@-
        -@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@-
        -@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@-
        -@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@-
        -@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@-
        -@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@-
        -@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@-
        -@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@-
        -@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@-
        -@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@-
        -@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@-
        -@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@-
        -@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@-
        -@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@-
        -@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@-
        -@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@-
        -@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@-
        -@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@-
        -@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@-
        --------------------------------
      `)
	if err := repeatN(75, func() error { return g.erode(0, 1) }); err != nil {
		return err
	}
	return repeatN(200, func() error {
		if err := g.erode(1, 2); err != nil {
			return err
		}
		return g.erode(2, 2)
	})
}

