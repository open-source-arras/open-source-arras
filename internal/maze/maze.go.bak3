		}
		if err := g.erodeSym2(2, 2); err != nil {
			return err
		}
		if err := g.erodeSym2(2, 2); err != nil {
			return err
		}
		return g.erodeSym2(2, 2)
	}); err != nil {
		return err
	}
	return repeatN(25, func() error { return g.erodeSym2(0, 0) })
}

