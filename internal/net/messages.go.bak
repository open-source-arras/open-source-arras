package net

// messages.go ports the message layer of js-src/server/game/network/sockets.js:
// one Go type per opcode, the code that turns it into []Value for the encoder,
// and the code that parses one back. The codec itself is fasttalk.go and is not
// touched here.
//
// Scope is the wire format only. Building a Photo from an entity, deciding when
// to send, the socket lifecycle and perspective() all live elsewhere.
//
// Positions in the comments are "after the opcode has been shifted off"
// (sockets.js:201, socketinit.js:827), matching docs/protocol.md section 3.
// Append writes the opcode first, because that is what talk() sends; Parse
// takes the post-shift slice, because that is what the dispatcher hands you.
// Opcode() splits one into the other.
//
// Expected bytes for the tests come from running the real JS — see
// tools/gen-message-vectors.js, which slices flatten(), publish(), floppy(),
// getstuff() and the Delta class straight out of sockets.js and evaluates them.

import (
	"errors"
	"math"
	"math/big"
	"strconv"
	"strings"
	"unicode/utf8"
)

// ---------------------------------------------------------------------------
// Frame assembly
// ---------------------------------------------------------------------------

// Builder turns a message into wire bytes without allocating in the steady
// state. One per connection; not safe for concurrent use.
//
// Every opcode follows the same two-step shape:
//
//	b.Frame(msg.Append(b.Buf()))
//
// Buf hands back the scratch slice emptied, Append fills it, Frame encodes it.
// Both the scratch slice and the Encoder's output buffer are retained, so a
// warm Builder allocates nothing. Do not call Buf twice without a Frame in
// between: the second call would hand out the same backing array.
type Builder struct {
	enc Encoder
	buf []Value
}

// Buf returns the reusable message buffer, emptied. Append into it.
func (b *Builder) Buf() []Value { return b.buf[:0] }

// Frame encodes an appended message. The returned bytes are owned by the
// Builder and are invalidated by the next call, exactly like Encoder.Encode.
func (b *Builder) Frame(msg []Value) ([]byte, error) {
	b.buf = msg
	return b.enc.Encode(msg)
}

// Grow presizes the scratch buffer. Worth calling once for the uplink, whose
// length scales with the number of visible entities.
func (b *Builder) Grow(n int) {
	if cap(b.buf) < n {
		b.buf = make([]Value, 0, n)
	}
}

// Opcode splits a decoded frame the way the two dispatchers do — m.shift() at
// sockets.js:201 and socketinit.js:827. ok is false for an empty frame or one
// whose first element is not a string; the JS switch would then fall through to
// its default, which logs and does nothing (sockets.js:731).
func Opcode(m []Value) (op string, rest []Value, ok bool) {
	if len(m) == 0 || m[0].Kind != KindString {
		return "", m, false
	}
	return m[0].Str, m[1:], true
}

// KickError is a validation failure that makes the JS call socket.kick with
// this exact reason string (sockets.js:203 and friends). The socket layer
// decides what to do with it; the reason text is reproduced verbatim so the
// Go server's logs stay comparable with Node's.
type KickError struct{ Reason string }

func (e *KickError) Error() string { return e.Reason }

func kick(reason string) error { return &KickError{Reason: reason} }

// ErrShortFrame is returned when a frame runs out of elements mid-structure.
// The JS reads past the end and gets undefined instead; Go cannot, so the
// packet is rejected. Only reachable from a hostile or corrupt peer.
var ErrShortFrame = errors.New("net: frame ended mid-message")

// ---------------------------------------------------------------------------
// JS semantics helpers
// ---------------------------------------------------------------------------

// jsRound is Math.round, which breaks ties toward +Infinity. Go's math.Round
// breaks them away from zero, so Math.round(-0.5) is -0 where math.Round(-0.5)
// is -1. Shield quantisation and leaderboard scores can both be negative, so
// the difference is live.
//
// Written as floor(x) plus a fraction test rather than floor(x+0.5) because
// x+0.5 is not exact for x just below 0.5.
func jsRound(x float64) float64 {
	if math.IsNaN(x) || math.IsInf(x, 0) {
		return x
	}
	f := math.Floor(x)
	if x-f >= 0.5 {
		f++
	}
	return f
}

// clamp is util.clamp (util.js:16): min(max(v, lo), hi).
func clamp(v, lo, hi float64) float64 { return math.Min(math.Max(v, lo), hi) }

// jsNumberString is Number.prototype.toString for base 10 — what String(x) and
// x.toString() produce. Needed because the `k` handler calls m[0].toString() on
// whatever arrived (sockets.js:207) and the `DTAST` handler calls String(m[0])
// (sockets.js:720); a hostile client controls both.
//
// Exact for every value the game produces. It follows the spec's switch to
// exponential form outside [1e-6, 1e21), which is where JS and Go's default
// formatting disagree.
func jsNumberString(f float64) string {
	switch {
	case math.IsNaN(f):
		return "NaN"
	case math.IsInf(f, 1):
		return "Infinity"
	case math.IsInf(f, -1):
		return "-Infinity"
	case f == 0:
		return "0" // covers -0, which JS also prints as "0"
	}
	a := math.Abs(f)
	if a >= 1e-6 && a < 1e21 {
		return strconv.FormatFloat(f, 'f', -1, 64)
	}
	s := strconv.FormatFloat(f, 'e', -1, 64)
	// Go writes e+07 where JS writes e+7.
	if i := strings.IndexByte(s, 'e'); i >= 0 {
		mant, exp := s[:i], s[i+1:]
		sign := ""
		if exp[0] == '+' || exp[0] == '-' {
			sign, exp = string(exp[0]), exp[1:]
		}
		exp = strings.TrimLeft(exp, "0")
		if exp == "" {
			exp = "0"
		}
		s = mant + "e" + sign + exp
	}
	return s
}

// jsToFixed1 is Number.prototype.toFixed(1). The `p` pong and svInfo both put
// its result on the wire as a string (sockets.js:337, speedLoop.js:24), and the
// pong argument comes straight from the client, so the rounding has to be the
// spec's and not Go's.
//
// ECMA-262 strips the sign first and then picks the integer n nearest to 10*|x|,
// preferring the larger n on a tie — so ties round away from zero, and the
// comparison is against the exact binary value. (0.35).toFixed(1) is "0.3"
// because 0.35 is really 0.34999999999999997779. big.Rat gets that exactly;
// float arithmetic does not.
func jsToFixed1(x float64) string {
	switch {
	case math.IsNaN(x):
		return "NaN"
	case math.IsInf(x, 1):
		return "Infinity"
	case math.IsInf(x, -1):
		return "-Infinity"
	case math.Abs(x) >= 1e21:
		return jsNumberString(x)
	}
	sign := ""
	if x < 0 {
		sign, x = "-", -x
	}
	r := new(big.Rat).SetFloat64(x)
	r.Mul(r, big.NewRat(10, 1))
	n := new(big.Int).Quo(r.Num(), r.Denom()) // x >= 0, so truncation is floor
	rem := new(big.Rat).Sub(r, new(big.Rat).SetInt(n))
	if rem.Cmp(big.NewRat(1, 2)) >= 0 {
		n.Add(n, big.NewInt(1))
	}
	d := n.String()
	if len(d) < 2 {
		d = "0" + d
	}
	return sign + d[:len(d)-1] + "." + d[len(d)-1:]
}

// jsonNumber is JSON.stringify of a number: the same text as String(x), except
// that the non-finite values become null (edge case 31 in docs/protocol.md).
func jsonNumber(f float64) string {
	if math.IsNaN(f) || math.IsInf(f, 0) {
		return "null"
	}
	return jsNumberString(f)
}

// jsTrim is String.prototype.trim's whitespace set, which is not Go's: JS trims
// U+FEFF and Go does not, Go trims U+0085 and JS does not. This runs on the
// permission key (sockets.js:207), where a mismatch would make a token that
// works against Node fail against Go.
// The set is ECMA-262 WhiteSpace plus LineTerminator: TAB VT FF SP NBSP
// ZWNBSP, LF CR LS PS, and the Zs category.
func jsTrim(s string) string {
	return strings.TrimFunc(s, func(r rune) bool {
		switch r {
		case '\t', '\v', '\f', ' ', '\u00a0', '\ufeff',
			'\n', '\r', '\u2028', '\u2029',
			'\u1680', '\u202f', '\u205f', '\u3000':
			return true
		}
		return r >= '\u2000' && r <= '\u200a'
	})
}

// valueString is what the JS gets when it calls String() or .toString() on a
// decoded element.
func valueString(v Value) string {
	if v.Kind == KindString {
		return v.Str
	}
	return jsNumberString(v.Num)
}

// truthy is JS truthiness for a decoded element. Booleans never survive the
// codec (fasttalk.js:281), so only "" and 0/NaN are falsy here.
func truthy(v Value) bool {
	if v.Kind == KindString {
		return v.Str != ""
	}
	return v.Num != 0 && !math.IsNaN(v.Num)
}

// strictEqual is JS ===, which the delta change detector uses
// (sockets.js:1695). NaN is unequal to itself; +0 and -0 are equal.
//
// One JS distinction is unreachable here: false !== 0 is true over there, but a
// Value folds a boolean into a number. No delta row carries a boolean inside
// its compared range — the leaderboard's only boolean is field 7, which
// DataLength excludes — so nothing depends on it.
func strictEqual(a, b Value) bool {
	if a.Kind != b.Kind {
		return false
	}
	if a.Kind == KindString {
		return a.Str == b.Str
	}
	return a.Num == b.Num // false for NaN, true for +0 vs -0
}

// nameTokens is encodeURI(name).split(/%..|./).length from the spawn handler
// (sockets.js:269), the only length limit the server enforces on a name.
//
// split returns matches+1 pieces, and every character survives encodeURI as
// either itself or a run of %XX escapes, one match each. So the count is one
// plus the number of URI-safe characters plus the number of UTF-8 bytes in the
// rest — which is why an emoji costs 4 and 47 ASCII characters is the real
// limit.
//
// One case cannot be reproduced: encodeURI throws a URIError on a lone
// surrogate, taking the handler down. Go strings cannot hold one — Decode turns
// it into U+FFFD — so that frame reaches here as 3 bytes instead.
func nameTokens(name string) int {
	n := 1
	for _, r := range name {
		if r < 0x80 && uriUnescaped(byte(r)) {
			n++
		} else {
			n += utf8.RuneLen(r)
		}
	}
	return n
}

// uriUnescaped is encodeURI's pass-through set: uriUnreserved plus uriReserved
// plus '#'.
func uriUnescaped(c byte) bool {
	switch {
	case c >= 'A' && c <= 'Z', c >= 'a' && c <= 'z', c >= '0' && c <= '9':
		return true
	}
	return strings.IndexByte("-_.!~*'();/?:@&=+$,#", c) >= 0
}

// QuantiseMinimap packs a world coordinate into the signed byte the minimap
// delta carries (sockets.js:1812). The client multiplies back by 255, not 256
// (socketinit.js:773) — a permanent 0.39% scale bias that must be preserved.
func QuantiseMinimap(v, roomDimension float64) float64 {
	return clamp(math.Floor((256*v)/roomDimension), -128, 127)
}

// SkillsHex is getstuff (sockets.js:890): the 20-character skills string, two
// hex digits per stat, written from shi down to atk. amount is indexed in the
// forward atk..shi order the stat lists use everywhere else (sockets.js:836),
// so this reverses it. The client reads the string forward
// (socketinit.js:722-733) and the statsdata triples are read backward
// (socketinit.js:716), which is the double reversal that makes the two agree.
//
// Amounts are skill levels, always small non-negative integers; a value outside
// 0..255 produces more or fewer than two digits here exactly as toString(16)
// does in the JS, and desynchronises the client's fixed-offset slices.
func SkillsHex(amount [10]float64) string {
	var b strings.Builder
	b.Grow(20)
	for i := 9; i >= 0; i-- {
		h := strconv.FormatInt(int64(amount[i]), 16)
		if len(h) < 2 {
			b.WriteByte('0')
		}
		b.WriteString(h)
	}
	return b.String()
}

// Stat order for the statsdata triples and for SkillsHex's input
// (sockets.js:836, :473).
var StatNames = [10]string{"atk", "hlt", "spd", "str", "pen", "dam", "rld", "mob", "rgn", "shi"}

// ---------------------------------------------------------------------------
// Unions
//
// Two fields genuinely take different wire tags depending on which code path
// built them. Both are modelled as small tagged structs rather than an empty
// interface, so building one still allocates nothing.
// ---------------------------------------------------------------------------

// MockupIndex is field 0 of `M`.
//
// ANSWER, open question 3. It is a number on the sendMockup path — parseInt of
// a split index, sockets.js:1437 — and a string on the load_all_mockups path,
// where mockupData[i].index is copied from the entity (mockups.js:7) and forced
// to a string by mockupEntity.js:143. Measured: index 12 as a number encodes
// f9 2a ff 4d 0c 7b 7d 00 (tag 0b0010, one data byte) and as the string "12"
// encodes f9 aa ff 4d 31 32 00 7b 7d 00 (tag 0b1010). Same value, different
// frame, so this has to be a union.
//
// Which fires when: the numeric form comes from every sendMockup call — the
// per-frame visible-entity push (sockets.js:1623), the leaderboard push
// (:1975), the `T` tank-tree handler (:679) and the daily tank (:2230). The
// string form is the bulk push at connect when Config.load_all_mockups is on
// (:2222) and the definition-reload rebroadcast (chatCommands.js:303,
// editor.js:152). Both fire in one session, because :1975 and :679 are not
// gated on load_all_mockups.
//
// The client tolerates both: global.mockups[m[0]] (socketinit.js:957) is an
// array subscript, and JS resolves the number 12 and the string "12" to the
// same slot. Verified against all 2492 built mockups: every .index is a string,
// and all of them are plain decimal numbers.
type MockupIndex struct {
	IsString bool
	Str      string
	Num      float64
}

func MockupIndexNum(n float64) MockupIndex { return MockupIndex{Num: n} }
func MockupIndexStr(s string) MockupIndex  { return MockupIndex{IsString: true, Str: s} }

func (m MockupIndex) value() Value {
	if m.IsString {
		return S(m.Str)
	}
	return N(m.Num)
}

func valueToMockupIndex(v Value) MockupIndex {
	if v.Kind == KindString {
		return MockupIndexStr(v.Str)
	}
	return MockupIndexNum(v.Num)
}

// ScoreValue is the nameplate score of a full entity record — entity.js:766,
// `this.settings.scoreLabel || score`.
//
// ANSWER, open question 4. scoreLabel is written in exactly two places in the
// tree, serverTravel.js:36 and :44, both template literals of the form
// "3 players", so the label branch is always a string; the fallback is
// skill.score, always a number. The branch is live rather than theoretical:
// Class.serverPortal resolves to TYPE "tank" with DISPLAY_NAME true, so its
// camera() sets 0x04 and the nameplate pair does reach the wire. A travel
// portal therefore puts a 0b1010 string in the slot every other tank fills with
// an integer tag.
type ScoreValue struct {
	IsLabel bool
	Label   string
	Score   float64
}

func Score(n float64) ScoreValue     { return ScoreValue{Score: n} }
func ScoreLabel(s string) ScoreValue { return ScoreValue{IsLabel: true, Label: s} }

func (s ScoreValue) value() Value {
	if s.IsLabel {
		return S(s.Label)
	}
	return N(s.Score)
}

func valueToScore(v Value) ScoreValue {
	if v.Kind == KindString {
		return ScoreLabel(v.Str)
	}
	return Score(v.Num)
}

// OptString is a string slot the client may leave empty by sending the literal
// false, which arrives as the number 0 (fasttalk.js:281). Only the spawn
// packet's transferbodyID does this — socketinit.js:938 sends
// `global.bodyID ? global.bodyID : false`, and sockets.js:273 only type-checks
// the slot when it is truthy.
type OptString struct {
	Present bool
	Value   string
}

func SomeString(s string) OptString { return OptString{Present: true, Value: s} }

func (o OptString) value() Value {
	if o.Present {
		return S(o.Value)
	}
	return B(false)
}

// ---------------------------------------------------------------------------
// Opcode strings
//
// The letters are reused across directions with different payloads
// (docs/protocol.md section 2.6), so dispatch must be direction-scoped and
// these are named accordingly.
// ---------------------------------------------------------------------------

// Server to client.
const (
	OpSvWelcome          = "W"
	OpSvKeyAccepted      = "w"
	OpSvRoomSetup        = "R"
	OpSvRoomRefresh      = "r"
	OpSvForceCamera      = "c"
	OpSvUplink           = "u"
	OpSvBroadcast        = "b"
	OpSvResetMinimap     = "RM"
	OpSvResetLeaderboard = "RL"
	OpSvMockup           = "M"
	OpSvDeath            = "F"
	OpSvPopup            = "m"
	OpSvPopupLines       = "Em"
