// Client to server.
const (
	OpClKey               = "k"
	OpClSpawn             = "s"
	OpClSync              = "S"
	OpClPing              = "p"
	OpClDownlink          = "d"
	OpClCommand           = "C"
	OpClKeys              = "#"
	OpClToggle            = "t"
	OpClUpgrade           = "U"
	OpClStat              = "x"
	OpClLevelUp           = "L"
	OpClSuicide           = "1"
	OpClControl           = "H"
	OpClChat              = "M"
	OpClTankTree          = "T"
	OpClDailyTankAd       = "DTA"
	OpClDailyTankAdDone   = "DTAD"
	OpClDailyTankAdStart  = "DTAST"
